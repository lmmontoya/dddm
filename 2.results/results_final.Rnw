\section{Optimal rule}


<<echo = F>>=
EYdopt_results$SL.odtr$SL.fit$coef
blip = -1*EYdopt_results$SL.odtr$SL.fit$SL.predict
cate_plot <- ggplot(
  data = data.frame(blip = blip),
  aes(x = blip)
) +
  geom_histogram(
    aes(y = after_stat(count / sum(count))),
    bins = 30,
    color = "black",
    fill = "grey80"
  ) +
  labs(
    x = "Estimated CATE",
    y = "Proportion of sample"
  ) +
  theme_minimal() +
  geom_vline(xintercept = 0, linetype = "dashed")

cate_plot

ggsave(filename = "paper dddm/3.figures/cate.png", plot = cate_plot, width = 6.5, height = 6, dpi = 300)

table(EYdopt_results$SL.odtr$dopt)
table(ifelse(blip < 0, 1, 0))
prop.table(table(ifelse(blip < 0, 1, 0)))
# dist of W

# Build analysis dataset
## ---- Build analysis dataset ----
table1_df <- data.frame(
  dopt = ifelse(blip < 0, 1, 0),
  W
)

## ---- Recode treatment variable ----
table1_df$dopt <- factor(
  table1_df$dopt,
  levels = c(0, 1),
  labels = c("TAU", "CBT")
)

## ---- Clean variable names ----
## Remove leading "W_" and replace "_" with spaces
names(table1_df) <- names(table1_df)
names(table1_df) <- gsub("^W_", "", names(table1_df))
names(table1_df) <- gsub("_", " ", names(table1_df))

## ---- Identify categorical covariates ----
## (exclude treatment variable)
factor_vars <- names(table1_df)[
  sapply(table1_df, is.factor) & names(table1_df) != "dopt"
]

## ---- Create Table 1 (NO tests, NO p-values) ----
table1 <- CreateTableOne(
  vars       = setdiff(names(table1_df), "dopt"),
  strata     = "dopt",
  data       = table1_df,
  factorVars = factor_vars,
  test       = FALSE
)

## ---- Convert Table 1 to printable matrix ----
table1_mat <- print(
  table1,
  showAllLevels = TRUE,
  quote = FALSE,
  noSpaces = TRUE,
  test = FALSE,
  printToggle = FALSE
)

## ---- Remove accidental "X..." prefixes from row names ----
rownames(table1_mat) <- gsub("^X+", "", rownames(table1_mat))

## ---- Export to LaTeX via xtable ----
xtab <- xtable(
  table1_mat,
  caption = "Baseline characteristics stratified by optimal treatment recommendation",
  label   = "tab:table1_odtr"
)

print(
  xtab,
  include.rownames = TRUE,
  booktabs = TRUE,
  sanitize.text.function = identity
)

@

\section{Values and contrasts}
<<echo = F>>=
1-EYdopt_results$EYdopt_estimates[c("Psi_TMLE", "CI_TMLE1", "CI_TMLE2"), 1]

# Create dataframe of contrasts
contrastest_results <- data.frame(
  t(
    EYdopt_results$EYdopt_estimates[
      c("Psi_TMLE", "CI_TMLE1", "CI_TMLE2"),
      -1
    ]
  )
)

colnames(contrastest_results) <- c(
  "Psi",
  "CI1",
  "CI2"
)

contrastest_results$dtr_name <- c(
  "Treat all",
  "Treat none",
  seq(0.1, 0.9, by = 0.1), "LSI",
  "Education",
  "Most serious arrest",
  "Antisocial intent",
  "All"
)

contrastest_results$rule_group <- c(
  rep("Static", 2),
  rep("Risk score", 10),
  rep("Subgroup", 4)
)

# Add optimal rule
opt_row <- data.frame(
  Psi = 0,
  CI1 = 0,
  CI2 = 0,
  dtr_name = "Optimal",
  rule_group = "Optimal\n(referent)"
)

contrastest_results <- dplyr::bind_rows(
  opt_row,
  contrastest_results
)

contrastest_results$rule_group <- factor(
  contrastest_results$rule_group,
  levels = c(
    "Optimal\n(referent)",
    "Static",
    "Risk score",
    "Subgroup"
  )
)

# Plot
contrastest_plot <- ggplot(
  contrastest_results,
  aes(x = dtr_name, y = Psi)
) +
  geom_hline(
    yintercept = 0,
    linetype = "dashed",
    color = "grey50"
  ) +
  geom_point(size = 3) +
  geom_errorbar(
    aes(ymin = CI1, ymax = CI2),
    width = 0.15
  ) +
  facet_grid(
    ~ rule_group,
    scales = "free_x",
    space = "free_x"
  ) +
  labs(
    #title = "Comparison of Data-Driven Treatment Decisions Relative to the Optimal Dynamic #\nTreatment Rule",
    x = "Dynamic treatment rule",
    y = "Estimated excess re-arrest risk"
  ) +
  theme_minimal() +
  theme(
    axis.text.x = element_text(
      angle = 45,
      hjust = 1
    ),
    strip.text = element_text(
      face = "bold"
    )
  )

contrastest_plot

ggsave(
  filename = "paper dddm/3.figures/values.png",
  plot = contrastest_plot,
  width = 9,
  height = 5,
  dpi = 300
)


