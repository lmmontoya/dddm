<<echo = F>>=
contrastest_results

library(dplyr)
library(xtable)

tab <- contrastest_results %>%
  transmute(
    `Rule group` = rule_group,
    `Treatment rule` = dtr_name,
    `Risk difference` = round(Psi, 3),
    `95\\% CI` = sprintf("(%.3f, %.3f)", CI1, CI2)
  )

# blank out repeated rule groups
tab$`Rule group` <- ifelse(
  duplicated(tab$`Rule group`),
  "",
  tab$`Rule group`
)

xt <- xtable(
  tab,
  caption = "Estimated risk difference in 2-year recidivism relative to the optimal treatment rule.",
  label = "tab:contrast_results",
  align = c("l", "l", "l", "l", "c")
)

print(
  xt,
  include.rownames = FALSE,
  sanitize.text.function = identity,
  comment = FALSE,
  booktabs = TRUE
)

