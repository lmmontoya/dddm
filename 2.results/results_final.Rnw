\section{Subgroup analysis}

<<echo = F>>=

levels(data$W_Arrest_MostSerious10.4)[levels(data$W_Arrest_MostSerious10.4) == "Drug crimes and minor crimes"] <- "Drug/minor crimes"
levels(data$W_HighestGrade3.1)[levels(data$W_HighestGrade3.1) == "Some college/grad/postgrad"] <- "Some college+"
levels(data$W_HighestGrade3.1)[levels(data$W_HighestGrade3.1) == "High school graduate/GED"] <- "High school grad/GED"
sig_Ws = names(results_subgroup)[unlist(lapply(1:length(results_subgroup), function(i) results_subgroup[[i]]$LRT_pval) < 0.1)]
W_names = c("Education", "Most serious arrest", "Antisocial intent")

# Build plotting dataframe
plot_df <- do.call(
  rbind,
  lapply(seq_along(sig_Ws), function(i) {

    x <- data[[sig_Ws[i]]]

    # Median split numeric variables
    if (is.numeric(x) && length(unique(x)) > 4) {
      x <- ifelse(
        x <= median(x, na.rm = TRUE),
        "Q1",
        "Q2"
      )
    }

    tmp <- data.frame(
      level = x,
      A = data$A_Condition,
      Y = data$Y_nonminorarrest0to2yr
    )

    risks <- tmp %>%
      group_by(level, A) %>%
      summarise(risk = mean(Y), .groups = "drop")

    levels_here <- sort(unique(risks$level))

    data.frame(
      subgroup = W_names[i],
      level = levels_here,
      cate = sapply(levels_here, function(l) {
        risks$risk[
          risks$A == "Intervention" &
            risks$level == l
        ] -
          risks$risk[
            risks$A == "Control" &
              risks$level == l
          ]
      })
    )
  })
)

# Cleaner labels
plot_df$level <- dplyr::recode(
  plot_df$level,
  "0-11th grade" = "0-11th\ngrade",
  "High school grad/GED" = "HS grad/\nGED",
  "Some college/grad/postgrad" = "Some\ncollege+",
  "Drug/minor crimes" = "Drug/\nminor",
  "Property crimes" = "Property",
  "Other person" = "Other",
  "Violent" = "Violent",
  "Q1" = "Below\nmedian",
  "Q2" = "Above\nmedian"
)

# Plot
subgroups_plot <- ggplot(
  plot_df,
  aes(x = level, y = cate)
) +
  geom_col(
    fill = "grey50",
    width = 0.6
  ) +
  geom_hline(
    yintercept = 0,
    linewidth = 0.4
  ) +
  facet_grid(
    ~ subgroup,
    scales = "free_x",
    space = "free_x"
  ) +
  labs(
    x = NULL,
    y = "Estimated re-arrest risk difference,\nCBT vs. treatment-as-usual"
  ) +
  theme_bw() +
  theme(
    legend.position = "none",
    panel.grid.major.x = element_blank(),
    strip.background = element_blank(),
    strip.text = element_text(size = 9),
    axis.text.x = element_text(size = 7),
    axis.text.y = element_text(size = 9),
    axis.title.y = element_text(size = 10)
  )

subgroups_plot

ggsave(
  filename = "paper dddm/3.figures/subgroups.png",
  plot = subgroups_plot,
  width = 8,
  height = 4.5,
  dpi = 300,
  bg = "white"
)

