\subsection{SuperLearner}
<<echo = F>>=
results_SL

df = data.frame(risk = results_riskscore, blip = -1*EYdopt_results$SL.odtr$SL.fit$SL.predict)
cor(df$risk, df$blip)
corr_predcate = ggplot(df, aes(x = blip, y = risk)) +
  geom_point() +
  geom_vline(xintercept = 0, linetype = "dashed") +
  geom_hline(yintercept = 0.5, linetype = "dashed") +
  scale_y_continuous(limits = c(0, 1)) +
  labs(
    x = "Estimated conditional average treatment effect (CATE) of CBT on re-arrest",
    y = "Estimated conditional risk of re-arrest"
  ) +
  theme_minimal()

corr_predcate

